# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PRODUCTION SUPABASE & POSTGRESQL (Optional when deploying backend)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# MOBILE FINANCIAL SERVICES (MFS) / PAYMENT GATEWAYS (OPTIONAL)
# If these variables are NOT set, Trendy & Bendy operates in Manual TrxID mode automatically.
# In Manual TrxID mode, customers pay directly to the business bKash, Nagad, or Bank account
# (configured in Admin Settings) and submit their Transaction ID (TrxID) for staff verification.

# bKash Gateway (Optional)
VITE_BKASH_APP_KEY=""
VITE_BKASH_APP_SECRET=""
VITE_BKASH_USERNAME=""
VITE_BKASH_PASSWORD=""

# Nagad Gateway (Optional)
VITE_NAGAD_MERCHANT_ID=""
VITE_NAGAD_PUBLIC_KEY=""

# SSLCommerz Gateway (Optional)
VITE_SSLCOMMERZ_STORE_ID=""
VITE_SSLCOMMERZ_STORE_PASS=""
